{
  "compilerOptions": {
    "target": "ES6",
    "lib": ["DOM", "ESNext", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "typeRoots": ["./node_modules/@types"],
    "types": ["vite/client", "@react-three/fiber"],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}